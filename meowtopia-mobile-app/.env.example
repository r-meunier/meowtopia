# Copy this file to .env (git-ignored) and fill in your own values.
# Expo (SDK 49+) loads EXPO_PUBLIC_* variables from .env automatically.
# On a physical device, use your computer's network address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_API_USERNAME=testuser2
EXPO_PUBLIC_API_PASSWORD=change-me
